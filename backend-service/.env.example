NODE_ENV=development
PORT=3000

# Comma-separated Sign in with Apple audiences.
# Usually your iOS bundle id and/or Services ID, depending on the client flow.
APPLE_CLIENT_IDS=

# Comma-separated Google OAuth client ids accepted for generic Google ID tokens.
GOOGLE_CLIENT_IDS=

# Web OAuth client configured as the Play Games Services game server credential.
GOOGLE_PLAY_WEB_CLIENT_ID=
GOOGLE_PLAY_WEB_CLIENT_SECRET=

