; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vaporwave Vikings Idle"
run/main_scene="res://scenes/run/run.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

Store="*res://autoload/store.gd"
Save="*res://autoload/save.gd"
Sync="*res://autoload/sync.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=480
window/size/window_width_override=960
window/size/window_height_override=480
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.16, 0.07, 0.26, 1)
